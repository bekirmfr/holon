flow ledger
port 8131
collection balances

route POST /accounts/:id (req) {
  account = req.params.id
  balance = (balances[account] ?? 0) + req.json.amount
  balances[account] = balance
  respond { balance: balance, posted_at: now }, missing: 400
}

route GET /accounts/:id (req) {
  respond balances[req.params.id]
}
