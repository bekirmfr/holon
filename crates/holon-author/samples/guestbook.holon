flow guestbook
port 8122
collection entries

js page = (book, clock) -> html {
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
  const ago = (t) => { const s = clock - t; return s < 60 ? "just now" : s < 3600 ? `${Math.floor(s / 60)} min ago` : s < 86400 ? `${Math.floor(s / 3600)} h ago` : `${Math.floor(s / 86400)} days ago`; };
  const items = Object.values(book).map((e) => `<li><b>${esc(e.name)}</b> ${esc(e.note)} <small>${ago(e.at)}</small></li>`);
  return `<!doctype html>
<meta charset="utf-8">
<title>Guestbook</title>
<style>body{font:16px/1.5 system-ui;max-width:40em;margin:3em auto;padding:0 1em}input,textarea{width:100%;box-sizing:border-box}small{color:#777}</style>
<h1>Guestbook</h1>
<form method="post" action="/sign">
  <p><input name="name" placeholder="Your name" required maxlength="40"></p>
  <p><textarea name="note" rows="3" placeholder="Leave a note" required maxlength="280"></textarea></p>
  <p><button>Sign</button></p>
</form>
<ul>${items.length ? items.join("\n") : "<li><i>Nobody has signed yet.</i></li>"}</ul>`;
}

js form = (body) -> fields {
  const decode = (s) => decodeURIComponent(s.replace(/\+/g, " "));
  const fields = {};
  for (const part of body.split("&")) {
    if (part === "") continue;
    const i = part.indexOf("=");
    fields[decode(i < 0 ? part : part.slice(0, i))] = i < 0 ? "" : decode(part.slice(i + 1));
  }
  if (!fields.name || !fields.note) throw new Error("a signature needs a name and a note");
  return fields;
}

route GET / (req) {
  respond page(entries.list(), now), headers: { "content-type": "text/html; charset=utf-8" }
}

route POST /sign (req) {
  signed = form(req.body)
  entries["{now}-{slice(sha256(as_text(random)), 0, 6)}"] = { name: signed.name, note: signed.note, at: now }
  respond "" when signed.name != "", headers: { location: "/" }, status: 303, missing: 400
}
