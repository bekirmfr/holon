# Calculator: a match.
#
# Answers a + b, a - b, a * b or a / b, by the op it is sent. A match picks one arm, and the
# others don't run. When the chosen arm has no value (a division by zero), the match has none
# either, so the route answers 400 rather than some other arm's value. An op with no arm answers
# 400 too.
#
# Try it: deploy it, then
#   curl -d '{"op":"add","a":1,"b":0}' http://127.0.0.1:8116/calc    1
#   curl -d '{"op":"div","a":1,"b":0}' http://127.0.0.1:8116/calc    400
flow calc
port 8116

# Answers the value of the op's arm, or 400 when it has none.
route POST /calc (req) {
  a = req.json.a
  b = req.json.b
  respond match req.json.op {
    "add" -> a + b
    "sub" -> a - b
    "mul" -> a * b
    "div" -> a / b
  }, missing: 400
}
