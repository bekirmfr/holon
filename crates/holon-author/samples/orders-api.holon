# Orders API: a database on the host.
#
# Places, lists and refunds orders in a SQL database an admin binds on the host: a SQLite file, or
# a Postgres or MySQL database, the flow's text the same on each. Each query is written in the
# flow, its values passed as $1, $2, ..., never into its text; its tables are the permission.
# Reads are answered as the run found them, and the writes land when the run finishes, in one
# transaction that first checks the rows it read are as it read them. A refund must change exactly
# one row: refunding an order twice changes none, so nothing lands and the run says so.
#
# Before it works, an admin binds the database, with its tables:
#   holon database add shop ~/holon-shop.db --schema "create table if not exists orders
#     (id integer primary key, customer text not null, total numeric not null,
#     refunded integer not null default 0);
#     create table if not exists refunds (order_id integer not null, amount numeric not null,
#     status integer)"
# On Postgres, start the server with HOLON_SECRET_SHOP_URL=postgres://user:password@host/shop in
# its environment and bind holon database add shop env:HOLON_SECRET_SHOP_URL --schema "...", the
# same tables with id integer generated by default as identity primary key and numeric(10,2)
# amounts (MySQL: mysql://..., and id integer primary key auto_increment). Totals then come back
# exact, as text.
#
# Try it: deploy it, then
#   curl -X POST -d '{"customer":"ada","total":"12.50"}' http://127.0.0.1:8150/orders
#   curl http://127.0.0.1:8150/orders/ada                ada's orders
#   curl -X POST http://127.0.0.1:8150/order/1/refund    twice: the second changes no row (409)
flow orders-api
port 8150
database shop

# Places an order.
route POST /orders (req) {
  shop.exec("insert into orders (customer, total) values ($1, $2)", req.json.customer, req.json.total)
  respond { placed: req.json.customer }, status: 201
}

# A customer's orders, in the order they were placed.
route GET /orders/:customer (req) {
  respond shop.query("select id, total, refunded from orders where customer = $1 order by id", req.params.customer)
}

# One order.
route GET /order/:id (req) {
  respond shop.one("select id, customer, total, refunded from orders where id = $1", req.params.id)
}

# Refunds an order once: it must change exactly one row, or nothing lands.
route POST /order/:id/refund (req) {
  shop.exec("update orders set refunded = 1 where id = $1 and refunded = 0", req.params.id, expect: 1)
  respond { refunded: req.params.id }
}
