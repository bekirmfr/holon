flow basket
port 8113
collection prices

route PUT /prices/:item (req) {
  prices[req.params.item] = req.json.price
  respond { item: req.params.item, price: req.json.price }
}

route POST /basket (req) {
  lines = map(req.json.items, fn: fn(item) -> { name: item.name, total: prices[item.name] * item.qty })
  respond { lines: lines, total: fold(0, lines, fn: fn(acc, line) -> acc + line.total) }
}
