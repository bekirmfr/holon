# Idempotent charges: one call per key.
#
# Charges once per Idempotency-Key. The same key with the same body answers the first charge
# again, the same key with a different body is refused (409), and a key expires after a day. The
# processor (httpbin.org, standing in) is called only when there is no prior charge. Two identical
# requests at once: the second waits for the first's claim on the key, reads what it wrote, and
# sends nothing.
#
# Try it: deploy it (holon deploy idempotent.holon), then send this twice:
#   curl -X POST -H 'Idempotency-Key: k1' -H 'Content-Type: application/json' \
#     -d '{"amount":42}' http://127.0.0.1:8121/charges
# The same id both times, the second with replayed: true. Send it with amount 43 for a 409. Run two
# at once with a fresh key, k2, and explain (holon mcp) shows the second claimed charges[k2],
# waited, and sent nothing.
flow idempotent
port 8121
collection charges

# Charges once per key: answers a prior charge again, refuses a different body (409), or charges.
route POST /charges (req) {
  key = req.headers["idempotency-key"]
  fingerprint = sha256(req.body)
  stored = charges[key]
  prior = stored when stored.expires_at > now
  replayed = (prior.fingerprint ?? "") == fingerprint
  mismatch = (prior.fingerprint ?? fingerprint) != fingerprint
  # Runs only when there is no prior charge: only the fresh charge needs it.
  processed = http.post("httpbin.org", "/post", headers: { "content-type": "application/json" }, body: req.body)
  fresh = { id: slice(sha256("{key}:{now}:{random}"), 0, 12), amount: req.json.amount, currency: req.json.currency ?? "EUR", processor_saw: parse_json(processed.body).json, fingerprint: fingerprint, charged_at: now, expires_at: now + 86400 }
  result = prior ?? fresh when !mismatch
  charges[key] = result
  respond { ..result, replayed: replayed }, missing: 409
}

# The charge kept under a key.
route GET /charges/:key (req) {
  respond charges[req.params.key]
}
