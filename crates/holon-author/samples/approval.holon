# Order approval: a durable run.
#
# An order waits for its payment. The run answers with a pay link at once, parks at the await,
# and finishes when the link is opened, hours or days later (the link lasts a day). Its progress
# goes out on the channel orders as it happens: "waiting for payment" as the run parks, "paid"
# when it finishes, and never the first one twice.
#
# Try it: deploy it, then
#   curl -X POST -H "Content-Type: application/json" -d '{"item":"book"}' \
#     http://127.0.0.1:8105/orders
# answers /paid/<token>. Open http://127.0.0.1:8105/paid/<token> and the order is paid: it is
# written to the state as last_order. In another terminal,
#   curl -N http://127.0.0.1:8105/orders/live
# shows each order's progress: "waiting for payment", then "paid".
flow approval
port 8105
channel orders

# Answers the pay link, says the order is waiting, then parks until the link is opened.
route POST /orders (req) {
  respond "/paid/{resume_token(paid)}"
  orders.send({ item: req.json.item, status: "waiting for payment" })
  paid = await paid, expires: 1d
  state.last_order = { ..req.json, paid_via: paid.method }
  orders.send({ item: req.json.item, status: "paid", via: paid.method })
}

# The pay link: opening it wakes the waiting order's run.
route GET /paid/:token (req) resumes paid {
  respond "thanks, the order is paid"
}

# Each order's progress as server-sent events, starting with the ones the channel keeps.
route GET /orders/live (req) {
  respond orders.subscribe(from: "kept")
}
