{
  "name": "holon",
  "displayName": "Holon",
  "description": "Holon flows (.holon.ts): each mistake holon check finds as you type, hover, completion and formatting, through holon lsp; and the Holon console beside the code.",
  "version": "0.1.0",
  "publisher": "bekirmfr",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/bekirmfr/holon"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.holon.ts",
    "onLanguage:typescript",
    "onCommand:holon.openConsole"
  ],
  "contributes": {
    "commands": [
      {
        "command": "holon.openConsole",
        "title": "Open console",
        "category": "Holon"
      }
    ],
    "configuration": {
      "title": "Holon",
      "properties": {
        "holon.path": {
          "type": "string",
          "default": "holon",
          "markdownDescription": "The `holon` command the extension starts as `holon lsp` and `holon serve`: its name on the PATH, or its full path."
        },
        "holon.consoleUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7420",
          "markdownDescription": "Where the Holon console is (`holon serve --at`). When nothing answers there and the address is on this machine, opening the console starts `holon serve` at it."
        }
      }
    }
  },
  "scripts": {
    "bundle": "esbuild extension.js --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify --sourcemap",
    "pretest:vscode": "npm run bundle",
    "test:vscode": "node test/integration/run.js",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package --skip-license --no-dependencies --out holon-vscode.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.0"
  }
}
