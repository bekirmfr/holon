{
  "name": "holon",
  "displayName": "Holon",
  "description": "Holon flows (.holon.ts): each mistake holon check finds as you type, hover, completion and formatting, through holon lsp; and the Holon sidebar: deployments, flows, history and graphs.",
  "version": "0.1.0",
  "publisher": "bekirmfr",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/bekirmfr/holon"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.holon.ts",
    "onLanguage:typescript",
    "onView:holon.deployments",
    "onView:holon.flows"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "holon",
          "title": "Holon",
          "icon": "media/holon.svg"
        }
      ]
    },
    "views": {
      "holon": [
        {
          "id": "holon.deployments",
          "name": "Deployments"
        },
        {
          "id": "holon.flows",
          "name": "Flows"
        }
      ]
    },
    "commands": [
      {
        "command": "holon.approveGrant",
        "title": "Approve",
        "icon": "$(check)",
        "category": "Holon"
      },
      {
        "command": "holon.showRun",
        "title": "Show run",
        "category": "Holon"
      },
      {
        "command": "holon.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Holon"
      },
      {
        "command": "holon.signIn",
        "title": "Sign in to the server",
        "category": "Holon"
      },
      {
        "command": "holon.startServer",
        "title": "Start the local server",
        "category": "Holon"
      },
      {
        "command": "holon.showHistory",
        "title": "Show history",
        "category": "Holon"
      },
      {
        "command": "holon.showFlow",
        "title": "Edit flow",
        "icon": "$(edit)",
        "category": "Holon"
      },
      {
        "command": "holon.deployFlow",
        "title": "Deploy flow",
        "icon": "$(rocket)",
        "category": "Holon"
      },
      {
        "command": "holon.openGraph",
        "title": "Open graph",
        "icon": "$(graph)",
        "category": "Holon"
      },
      {
        "command": "holon.run",
        "title": "Run",
        "category": "Holon"
      },
      {
        "command": "holon.pause",
        "title": "Pause",
        "category": "Holon"
      },
      {
        "command": "holon.stop",
        "title": "Stop",
        "category": "Holon"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "holon.refresh",
          "when": "view == holon.deployments || view == holon.flows",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "holon.approveGrant",
          "when": "view == holon.deployments && viewItem == grant",
          "group": "inline@1"
        },
        {
          "command": "holon.approveGrant",
          "when": "view == holon.deployments && viewItem == grant",
          "group": "1_grant@1"
        },
        {
          "command": "holon.showHistory",
          "when": "view == holon.deployments && viewItem == deployment",
          "group": "inline@1"
        },
        {
          "command": "holon.run",
          "when": "view == holon.deployments && viewItem == deployment",
          "group": "1_lifecycle@1"
        },
        {
          "command": "holon.pause",
          "when": "view == holon.deployments && viewItem == deployment",
          "group": "1_lifecycle@2"
        },
        {
          "command": "holon.stop",
          "when": "view == holon.deployments && viewItem == deployment",
          "group": "1_lifecycle@3"
        },
        {
          "command": "holon.showHistory",
          "when": "view == holon.deployments && viewItem == deployment",
          "group": "2_show@1"
        },
        {
          "command": "holon.showFlow",
          "when": "view == holon.flows && viewItem == flow",
          "group": "inline@1"
        },
        {
          "command": "holon.openGraph",
          "when": "view == holon.flows && viewItem == flow",
          "group": "inline@2"
        },
        {
          "command": "holon.deployFlow",
          "when": "view == holon.flows && viewItem == flow",
          "group": "inline@3"
        },
        {
          "command": "holon.showFlow",
          "when": "view == holon.flows && viewItem == flow",
          "group": "2_show@1"
        },
        {
          "command": "holon.openGraph",
          "when": "view == holon.flows && viewItem == flow",
          "group": "2_show@2"
        },
        {
          "command": "holon.deployFlow",
          "when": "view == holon.flows && viewItem == flow",
          "group": "2_show@3"
        }
      ]
    },
    "configuration": {
      "title": "Holon",
      "properties": {
        "holon.path": {
          "type": "string",
          "default": "holon",
          "markdownDescription": "The `holon` command the extension runs: `holon lsp`, `holon serve`, and the sidebar's commands. Its name on the PATH, or its full path."
        },
        "holon.consoleUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7420",
          "markdownDescription": "The Holon server the sidebar shows (`holon serve --at`). When nothing answers there and the address is on this machine, the sidebar can start `holon serve` at it."
        }
      }
    }
  },
  "scripts": {
    "bundle": "esbuild extension.js --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify --sourcemap",
    "pretest:vscode": "npm run bundle",
    "test:vscode": "node test/integration/run.js",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package --skip-license --no-dependencies --out holon-vscode.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.0"
  }
}
